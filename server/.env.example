NODE_ENV=development_or_production
PORT=4000
MONGO_URI=get_from_mongodb_atlas_dashboard_connect_section
CLIENT_URL=http://localhost:5173_or_your_live_frontend_url
JWT_ACCESS_SECRET=generate_any_random_32_character_string
JWT_REFRESH_SECRET=generate_another_random_32_character_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=15d
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=get_free_key_from_console.groq.com/keys
OPENAI_MODEL=llama-3.3-70b-versatile
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address
SMTP_PASSWORD=get_from_google_account_security_app_passwords
SMTP_FROM=your-configured-email@domain.com
ADMIN_NOTIFICATION_EMAIL=your_email_to_receive_admin_alerts
LEAD_ACKNOWLEDGEMENT_ENABLED=false
WEBHOOK_SECRET=create_any_custom_password_for_webhooks
